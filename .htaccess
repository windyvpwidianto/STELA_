# ============================================================
# STELA Security Configuration (.htaccess)
# ============================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Block direct access to hidden files and sensitive configuration files
<FilesMatch "(^\.|\.env|composer\.(json|lock)|docker-compose\.ya?ml|README\.md|\.sql|\.log|\.git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block direct web access to internal application directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bootstrap|config|database|docs|storage)/ - [F,L,NC]
</IfModule>
